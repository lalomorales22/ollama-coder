/* OllamaCoder — neon-on-graphite terminal theme */

Screen {
    background: #08090d;
    color: #cbd5e1;
}

/* height 1 with no border: a border would consume the only content row */
#statusbar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: #12161f;
    color: #e2e8f0;
}

#main {
    height: 1fr;
}

#conversation {
    width: 1fr;
    height: 1fr;
}

#transcript {
    height: 1fr;
    padding: 1 2 0 2;
    scrollbar-size: 1 1;
    scrollbar-color: #1e293b;
    scrollbar-color-hover: #22d3ee;
    scrollbar-background: #08090d;
}

#sidebar {
    width: 32;
    height: 1fr;
    background: #0b0e14;
    border-left: solid #1b2130;
    padding: 1;
    scrollbar-size: 1 1;
}

.panel {
    margin-bottom: 1;
    padding: 0 1;
    border-left: solid #1e293b;
}

/* ---- message blocks ---- */

.msg-user {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: solid #22d3ee;
}

.msg-assistant {
    margin: 1 0;
    padding: 0 1;
}

.msg-thinking {
    margin: 0 0 0 1;
    padding: 0 1;
    color: #52606d;
}

.notice {
    margin: 0 0 0 1;
    padding: 0 1;
}

.raw {
    margin: 1 0;
}

/* ---- tool cards ---- */

.tool-card {
    margin: 0 0 0 1;
    padding: 0 1;
    border-left: solid #1e293b;
}

.tool-card.running {
    border-left: solid #22d3ee;
}

.tool-card.ok {
    border-left: solid #16603a;
}

.tool-card.error {
    border-left: solid #f87171;
}

.tool-card.denied {
    border-left: solid #fbbf24;
}

/* ---- composer ---- */

#composer {
    dock: bottom;
    height: auto;
    max-height: 12;
    min-height: 3;
    margin: 0 1 0 1;
    padding: 0 1;
    background: #0d1017;
    border: round #1e293b;
    color: #e2e8f0;
}

#composer:focus {
    border: round #22d3ee;
}

/* ---- modals ---- */

ApprovalScreen {
    align: center middle;
    background: #05060a 88%;
}

#approval-box {
    width: 88%;
    max-width: 120;
    height: auto;
    max-height: 80%;
    background: #0d1017;
    border: round #f472b6;
    padding: 1 2;
}

#approval-header {
    height: auto;
    margin-bottom: 1;
}

#approval-body {
    height: auto;
    max-height: 24;
    margin-bottom: 1;
}

#approval-footer {
    height: auto;
    margin-bottom: 1;
}

#approval-buttons {
    height: auto;
    align: center middle;
}

#approval-buttons Button {
    margin: 0 1;
    min-width: 20;
}

FeedbackScreen {
    align: center middle;
    background: #05060a 88%;
}

#feedback-box {
    width: 70%;
    max-width: 90;
    height: auto;
    background: #0d1017;
    border: round #fbbf24;
    padding: 1 2;
}

#feedback-label {
    margin-bottom: 1;
}

PickerScreen {
    align: center middle;
    background: #05060a 88%;
}

#picker-box {
    width: 80%;
    max-width: 100;
    height: 60%;
    background: #0d1017;
    border: round #22d3ee;
    padding: 1 2;
}

#picker-title {
    margin-bottom: 1;
}

#picker-list {
    height: 1fr;
    background: #0d1017;
    border: none;
}

HelpScreen {
    align: center middle;
    background: #05060a 90%;
}

#help-box {
    width: 90%;
    max-width: 110;
    height: 85%;
    background: #0d1017;
    border: round #22d3ee;
    padding: 1 2;
}

#help-title {
    margin-bottom: 1;
}

#help-body {
    height: 1fr;
}

#help-footer {
    margin-top: 1;
}
