#!/usr/bin/env bash
# Review staged changes with OllamaCoder before every commit.
#
#   cp examples/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Skip it for one commit with:  SKIP_REVIEW=1 git commit
# Exit 0 = commit proceeds, 1 = blocked.

set -uo pipefail

[ -n "${SKIP_REVIEW:-}" ] && exit 0
command -v ollama-coder >/dev/null || exit 0

DIFF=$(git diff --cached --diff-filter=ACMR)
[ -z "$DIFF" ] && exit 0

MODEL="${REVIEW_MODEL:-qwen3:8b}"
RESULT=$(mktemp)
trap 'rm -f "$RESULT"' EXIT

echo "reviewing staged changes with $MODEL…"

# --read-only means no tool can modify the tree, whatever the model decides.
ollama-coder \
    --model "$MODEL" \
    --read-only \
    --quiet \
    --max-steps 12 \
    --timeout 180 \
    --output json \
    -p "Review this staged diff. Report ONLY defects you are confident about:
a real bug, a security problem, a secret being committed, or a debug
statement left behind. Style opinions are not defects.

If you find one, start your reply with the exact token BLOCK.
If the diff is fine, reply with exactly: OK

$DIFF" > "$RESULT"

STATUS=$?
RESPONSE=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("response",""))' "$RESULT" 2>/dev/null)

if [ $STATUS -eq 1 ]; then
    echo "review could not run; committing anyway"
    exit 0
fi

if printf '%s' "$RESPONSE" | grep -q "BLOCK"; then
    echo
    echo "commit blocked by review:"
    printf '%s\n' "$RESPONSE"
    echo
    echo "commit anyway with: SKIP_REVIEW=1 git commit"
    exit 1
fi

echo "review passed"
exit 0
